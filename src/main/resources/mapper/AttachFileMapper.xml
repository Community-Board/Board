<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.board.mapper.AttachFileMapper">

	<!-- 파일 업로드 -->
	<insert id="uploadFile" parameterType="AttachFileVO">
		INSERT INTO board.attach_file
			(file_name, file_src, board_no)
		VALUES
			(#{fileName}, #{fileSrc}, #{boardNo})
	</insert>
</mapper>